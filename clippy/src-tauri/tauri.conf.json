{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clippy",
  "version": "0.1.0",
  "identifier": "com.devin.clippy",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clippy",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: http://ipc.localhost; media-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: tauri: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "mov", "webm", "m4v", "avi"],
        "name": "Video",
        "description": "Video file (Clippy)",
        "role": "Editor"
      }
    ]
  }
}
